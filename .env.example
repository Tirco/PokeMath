# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# Required – used to sign teacher session tokens
SECRET_KEY=change_me_to_a_long_random_string

# Required – password for the admin panel (/pokemorten)
ADMIN_PASSWORD=change_me

# Server
PORT=8080
SITE_URL=https://pokemath.online

# MySQL database
MYSQL_HOST=localhost
MYSQL_USER=db_user
MYSQL_PASSWORD=db_password
MYSQL_DATABASE=db_name

# Email (SMTP) – leave blank to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PokeMath <no-reply@pokemath.online>
